generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  password       String
  createdAt      DateTime        @default(now())
  role           String          @default("USER")
  comments       Comment[]
  likes          Like[]
  purchases      Purchase[]
  reviews        Review[]
  storyPurchases StoryPurchase[]

  // Coin wallet used to unlock story chapters
  coins            Int               @default(0)
  chapterUnlocks   ChapterUnlock[]
  coinTransactions CoinTransaction[]
}

model Comic {
  id           String     @id @default(uuid())
  title        String
  description  String
  price        Float
  imageUrl     String
  createdAt    DateTime   @default(now())
  pages        Json?
  previewPages Json?
  isPublished  Boolean    @default(false)
  comments     Comment[]
  purchases    Purchase[]
  reviews      Review[]
}

model Purchase {
  id        String   @id @default(uuid())
  userId    String
  comicId   String
  createdAt DateTime @default(now())
  comic     Comic    @relation(fields: [comicId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, comicId])
}

model Newsletter {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())
  name      String?
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  comicId   String?
  storyId   String?
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  comic     Comic?   @relation(fields: [comicId], references: [id])
  story     Story?   @relation(fields: [storyId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, comicId])
  @@unique([userId, storyId])
  @@index([comicId])
  @@index([storyId])
}

model Comment {
  id        String    @id @default(uuid())
  userId    String
  comicId   String?
  storyId   String?
  text      String
  createdAt DateTime  @default(now())
  parentId  String?

  comic     Comic?    @relation(fields: [comicId], references: [id])
  story     Story?    @relation(fields: [storyId], references: [id])

  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies   Comment[] @relation("CommentReplies")

  user      User      @relation(fields: [userId], references: [id])
  likes     Like[]

  @@index([comicId])
  @@index([storyId])
  @@index([parentId])
}

model Like {
  id        String   @id @default(uuid())
  userId    String
  commentId String
  createdAt DateTime @default(now())
  comment   Comment  @relation(fields: [commentId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, commentId])
  @@index([commentId])
}

model Story {
  id          String          @id @default(uuid())
  title       String
  subtitle    String?
  description String?
  coverImage  String?
  // Legacy whole-book price. Stories are now sold per chapter with coins.
  price       Float           @default(0)
  // Legacy single-body content. Story text now lives in Chapter.content.
  content     Json?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  isPublished Boolean         @default(false)

  chapters    Chapter[]
  // Legacy whole-book purchases. Owners keep access to every chapter.
  purchases   StoryPurchase[]
  reviews     Review[]
  comments    Comment[]
}

model Chapter {
  id          String          @id @default(uuid())
  storyId     String
  number      Int
  title       String
  content     Json
  // Free chapters can be read by anyone. Paid chapters cost `price` coins.
  isFree      Boolean         @default(false)
  price       Int             @default(0)
  isPublished Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  story       Story           @relation(fields: [storyId], references: [id], onDelete: Cascade)
  unlocks     ChapterUnlock[]

  @@index([storyId, number])
}

model ChapterUnlock {
  id         String   @id @default(uuid())
  userId     String
  chapterId  String
  coinsSpent Int
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter    Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([userId, chapterId])
  @@index([chapterId])
}

// Admin-defined bundles: pay `priceNaira`, receive `coins`.
model CoinPackage {
  id         String   @id @default(uuid())
  name       String
  coins      Int
  priceNaira Float
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Ledger of every coin balance change.
model CoinTransaction {
  id          String   @id @default(uuid())
  userId      String
  // PURCHASE | UNLOCK | ADJUSTMENT
  type        String
  // Positive when coins are added, negative when spent.
  coins       Int
  amountNaira Float?
  // Paystack reference for purchases. Unique so a payment is only credited once.
  reference   String?  @unique
  chapterId   String?
  description String?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model StoryPurchase {
  id        String   @id @default(uuid())
  userId    String
  storyId   String
  createdAt DateTime @default(now())
  story     Story    @relation(fields: [storyId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, storyId])
}
